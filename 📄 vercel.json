{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "backend/api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "source": "/api/(.*)",
      "destination": "backend/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1",
      "handle": "filesystem"
    }
  ]
}
